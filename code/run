#!/usr/bin/env bash
# Entry point: verify the neuroimaging toolchain built into this capsule's image.
# 1) command-line checks (check_tools.sh), 2) GUI checks on a virtual display (check_gui.sh).
set -uo pipefail

status=0
bash /code/check_tools.sh || status=1
bash /code/check_gui.sh || status=1
exit $status
